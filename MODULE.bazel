"""Bazel module definition for Quary."""

module(
    name = "quary",
    version = "0.0.0",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_js", version = "3.2.2")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "rules_rust", version = "0.68.1")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.68.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_shellcheck", version = "0.4.0")

# Platform-aware tool downloads.
tools = use_extension("//:tools.bzl", "tools")
use_repo(tools, "ratchet")

# Hermetic Node.js and pnpm toolchains.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
# Explicit checksums support releases newer than rules_nodejs' built-in list.
node.toolchain(
    node_version = "24.21.0",
    node_repositories = {
        "24.21.0-darwin_amd64": [
            "node-v24.21.0-darwin-x64.tar.xz",
            "node-v24.21.0-darwin-x64",
            "0ae5a24c24bb7d015cd816c5036b3f90f2945aa872fcf54e58da054753b3a299",
        ],
        "24.21.0-darwin_arm64": [
            "node-v24.21.0-darwin-arm64.tar.xz",
            "node-v24.21.0-darwin-arm64",
            "6239d4cf92d864487ec8cd3615038f7b67e7f58b77b21cd2f09ea9fbd68065fe",
        ],
        "24.21.0-linux_amd64": [
            "node-v24.21.0-linux-x64.tar.xz",
            "node-v24.21.0-linux-x64",
            "fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6",
        ],
        "24.21.0-linux_arm64": [
            "node-v24.21.0-linux-arm64.tar.xz",
            "node-v24.21.0-linux-arm64",
            "6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2",
        ],
        "24.21.0-linux_ppc64le": [
            "node-v24.21.0-linux-ppc64le.tar.xz",
            "node-v24.21.0-linux-ppc64le",
            "1936fd64623a2f98d1fb31b456686d10c30e92639899cfefdefa8835d22adccd",
        ],
        "24.21.0-linux_s390x": [
            "node-v24.21.0-linux-s390x.tar.xz",
            "node-v24.21.0-linux-s390x",
            "2ef7e2ecbf7a6c2f3d08d106f6b2f279419c6dac89fe91b8cad193af7890082c",
        ],
        "24.21.0-windows_amd64": [
            "node-v24.21.0-win-x64.zip",
            "node-v24.21.0-win-x64",
            "158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541",
        ],
        "24.21.0-windows_arm64": [
            "node-v24.21.0-win-arm64.zip",
            "node-v24.21.0-win-arm64",
            "8779b1bde1d39f8d420e3b57aa657b39891af434d3de44a919044cec06785921",
        ],
    },
)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
        "//js/packages/eslint-config-shared:package.json",
        "//js/packages/proto:package.json",
        "//js/packages/quary-extension:package.json",
        "//js/packages/quary-extension-bus:package.json",
        "//js/packages/quary-extension-ui:package.json",
    ],
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.0.0",
)
use_repo(pnpm, "pnpm")

# Hermetic Rust toolchain, including the target used by the VS Code extension.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = ["wasm32-unknown-unknown"],
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")
register_toolchains("@rules_rust//rust/private/dummy_cc_toolchain:dummy_cc_wasm32_toolchain")

# Resolve third-party crates from the checked-in Cargo manifests and lockfile.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//proto/gen/rust:Cargo.toml",
        "//rust/cli:Cargo.toml",
        "//rust/core:Cargo.toml",
        "//rust/dbt-converter:Cargo.toml",
        "//rust/pbjson-types:Cargo.toml",
        "//rust/quary-databases:Cargo.toml",
        "//rust/wasm-binding:Cargo.toml",
    ],
)
use_repo(crate, "crates")
