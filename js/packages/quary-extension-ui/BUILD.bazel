load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//js/packages/quary-extension-ui:eslint/package_json.bzl", eslint_bin = "bin")

exports_files(["package.json"])

npm_link_all_packages(name = "node_modules")

eslint_bin.eslint_test(
    name = "eslint_check",
    size = "small",
    args = [
        "src",
        "--report-unused-disable-directives",
        "--max-warnings",
        "0",
    ],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":prettier_srcs",
        "//js/packages/eslint-config-shared:node_modules",
    ],
)

alias(
    name = "pkg",
    actual = ":prettier_srcs",
    visibility = ["//visibility:public"],
)

js_library(
    name = "prettier_srcs",
    srcs = glob([
        "**/*.css",
        "**/*.html",
        "**/*.js",
        "**/*.json",
        "**/*.ts",
        "**/*.tsx",
    ], exclude = [
        "dist/**",
        "node_modules/**",
        "storybook-static/**",
    ], allow_empty = True),
    visibility = ["//visibility:public"],
)
